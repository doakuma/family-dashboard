# 이 파일은 키 이름만 둔다. 실제 값은 .env(레포 제외)에 넣는다.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_FAMILY_CHANNEL=
ANTHROPIC_API_KEY=
WIKI_REPO_PATH=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
KMA_SERVICE_KEY=
KMA_NX=
KMA_NY=
KMA_MID_LAND_REG_ID=
KMA_MID_TA_REG_ID=
TZ=Asia/Seoul
# 아래는 스펙 rev 31에서 추가
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
ANTHROPIC_MODEL=claude-haiku-5-5
# 아래는 #17 (관리자 PIN·내부망). 값은 .env에만 둔다
# `pnpm pin:hash`가 출력하는 한 줄(ADMIN_PIN_HASH=scrypt:...)을 그대로 붙여 넣는다. 서버는 .env에 쓰지 않는다.
ADMIN_PIN_HASH=
# 태블릿 QR에 들어갈 대시보드 주소 (예: http://192.168.0.20:3000). 운영에서는 필수, 개발에서는 localhost로 대신한다.
DASHBOARD_BASE_URL=
